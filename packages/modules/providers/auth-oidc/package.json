{
  "name": "@arcangel/auth-oidc",
  "version": "2.20.1",
  "description": "Generic OpenID Connect (OIDC) authentication provider for Arcangel",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcangel/arcangel.git",
    "directory": "packages/modules/providers/auth-oidc"
  },
  "bugs": {
    "url": "https://github.com/arcangel/arcangel/issues"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Arcangel",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "../../../../node_modules/.bin/jest --passWithNoTests src",
    "test:integration": "../../../../node_modules/.bin/jest --passWithNoTests --forceExit --testPathPattern=\"integration-tests/__tests__/.*\\.spec\\.ts\"",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build",
    "watch": "yarn run -T tsc --watch"
  },
  "dependencies": {
    "openid-client": "^5.7.1"
  },
  "devDependencies": {
    "@arcangel/framework": "2.20.1"
  },
  "peerDependencies": {
    "@arcangel/framework": "2.20.1"
  },
  "keywords": [
    "arcangel-provider",
    "arcangel-provider-auth-oidc"
  ]
}
