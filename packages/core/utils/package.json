{
  "name": "@arcangel/utils",
  "version": "2.20.1",
  "description": "Arcangel utilities functions shared by Arcangel core and Modules",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcangel/arcangel.git",
    "directory": "packages/core/utils"
  },
  "bugs": {
    "url": "https://github.com/arcangel/arcangel/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "author": "Arcangel",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@arcangel/types": "2.20.1",
    "express": "^4.21.0"
  },
  "dependencies": {
    "@arcangel/deps": "2.20.1",
    "@graphql-codegen/core": "^4.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-tools/merge": "^9.0.7",
    "@graphql-tools/schema": "^10.0.6",
    "@types/pluralize": "^0.0.33",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "graphql": "^16.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg-connection-string": "^2.7.0",
    "pluralize": "^8.0.0",
    "ulid": "^2.3.0"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  },
  "scripts": {
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build",
    "watch": "yarn run -T tsc --build --watch",
    "test": "../../../node_modules/.bin/jest --silent=false --bail --forceExit --testPathIgnorePatterns='/integration-tests/' --testPathPattern=src",
    "test:integration": "../../../node_modules/.bin/jest --passWithNoTests --silent --bail --forceExit --testPathPattern=\"src/.*/integration-tests/__tests__/.*\\.spec\\.ts\""
  }
}
