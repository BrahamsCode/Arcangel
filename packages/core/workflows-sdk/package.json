{
  "name": "@arcangel/workflows-sdk",
  "version": "2.20.1",
  "description": "Set of workflows tooling for Arcangel",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./composer": "./dist/utils/composer/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcangel/arcangel.git",
    "directory": "packages/core/workflows-sdk"
  },
  "bugs": {
    "url": "https://github.com/arcangel/arcangel/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "author": "Arcangel",
  "license": "MIT",
  "devDependencies": {
    "@arcangel/types": "2.20.1"
  },
  "dependencies": {
    "@arcangel/deps": "2.20.1",
    "@arcangel/modules-sdk": "2.20.1",
    "@arcangel/orchestration": "2.20.1",
    "@arcangel/utils": "2.20.1",
    "ulid": "^2.3.0"
  },
  "scripts": {
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build",
    "watch": "yarn run -T tsc --build --watch",
    "test": "../../../node_modules/.bin/jest --bail --forceExit --testPathPattern=src",
    "test:run": "node ./dist/utils/_playground.js"
  }
}
