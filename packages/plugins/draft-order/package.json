    "react-hook-form": "7.83.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@arcangel/admin-sdk": "2.20.1",
    "@arcangel/cli": "2.20.1",
    "@arcangel/dashboard": "2.20.1",
