    "./*": "./.arcangel/server/src/*.js",
    "./admin": {
      "import": "./.arcangel/server/src/admin/index.mjs",
      "require": "./.arcangel/server/src/admin/index.js",
      "default": "./.arcangel/server/src/admin/index.js"
    }
  },
  "keywords": [
    "arcangel",
    "plugin",
    "arcangel-plugin-other",
    "arcangel-plugin",
    "arcangel-v2"
  ],
  "scripts": {
    "build:plugin": "arcangel plugin:build",
    "dev": "arcangel plugin:develop",
    "prepare": "cross-env NODE_ENV=production yarn run build:plugin",
    "link:watch": "arcangel plugin:publish && arcangel plugin:develop",
    "watch": "arcangel plugin:develop"
  },
  "dependencies": {
