{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["!node_modules/**", "!src/**", "*/**", ".arcangel/**"]
    },
    "build:plugin": {
      "dependsOn": ["^build", "@arcangel/arcangel#build"],
      "outputs": ["!node_modules/**", "!src/**", ".arcangel/**"]
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "outputs": []
    },
    "test:integration:chunk": {
      "outputs": []
    }
  },
  "globalDependencies": ["turbo.json"]
}
